{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "vitest.config.ts",
    "scripts/**/*.test.ts",
    "packages/**/*.test.ts",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "spikes/**"]
}
